# Copy this file to .env for local development. Never commit .env (it is in .gitignore).
# On Render these are set in the dashboard (Environment), not in a file. See HANDOVER.md.

# --- Django
DJANGO_DEBUG=1                         # 1 = local development only. Must be 0 (or unset) in production.
SECRET_KEY=                            # required when DEBUG is 0. Render generates it for you.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,tienghana.org,www.tienghana.org
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://tienghana.org,https://www.tienghana.org
ADMIN_PATH=secretariat-admin/          # the admin lives at /secretariat-admin/

# --- Database. Leave empty locally to use SQLite. In production, paste the Neon connection string:
DATABASE_URL=                          # e.g. postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- First admin account (created once by build.sh if it does not exist)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=             # at least 8 characters, not a common password, not all numbers

# --- Paystack. Leave empty and the donate page shows "Online giving opens soon" with a contact form.
# Use TEST keys (sk_test_ / pk_test_) until launch, then switch to live keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
